# Backend environment variables
# Copy this file to .env and customize

# Database
# For SQLite (development): leave empty or use file path
# For PostgreSQL: postgresql://user:pass@localhost:5432/nexus_nav
NEXUS_NAV_DB=

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=*